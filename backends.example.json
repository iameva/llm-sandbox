{
  "defaults": {
    "claude": "claude",
    "codex": "chatgpt",
    "omp": "chatgpt",
    "opencode": "chatgpt"
  },
  "profiles": {
    "claude": {
      "provider": "anthropic",
      "auth": "login",
      "model": "opus",
      "fast_model": "haiku"
    },
    "chatgpt": {
      "provider": "openai",
      "auth": "login",
      "model": "gpt-6-astra",
      "fast_model": "gpt-5.6-luna"
    },
    "deepseek": {
      "provider": "deepseek",
      "auth": "api_key",
      "model": "deepseek-v4-pro",
      "fast_model": "deepseek-flash",
      "key_env": "DEEPSEEK_API_KEY",
      "key_file": "~/.config/deepseek.api"
    }
  }
}
